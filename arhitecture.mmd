flowchart TD

subgraph ENTRY["main.cpp — Entry Point"]
MAIN["main()"]
end

subgraph INIT["Initialization Phase"]
MAKESTRAT["AStrategy strategy — stack object"]
MAKESIM["make_unique AStrategy — copy constructs heap object; Simulator takes ownership"]
LOAD["Simulator::loadHistoricalEvents(path)"]
PARSE["operator>> — parses symbol, timestamp, side, quantity, type, price"]
MKADD["new AddOrderEvent"]
ADDBOOK["Simulator::addBook(symbol)"]
SORT["stable_sort historical events by timestamp"]
SCHED0["Simulator::scheduleTimer — initial"]
end

MAIN -->|creates| MAKESTRAT
MAIN -->|constructs Simulator with| MAKESIM
MAIN -->|calls| LOAD

LOAD -->|opens file and loops| PARSE
PARSE -->|on success constructs| MKADD
LOAD -->|calls per parsed order| ADDBOOK

ADDBOOK -->|emplaces OrderBook into| M_BOOKS[("Simulator::m_orderBooks<br/>unordered_map<Symbol, OrderBook>")]
MKADD -->|push_back into| M_HIST[("Simulator::m_historicalEvents<br/>vector<unique_ptr<Event>>")]

LOAD -->|calls once done| SORT
SORT -->|sorts| M_HIST

MAIN -->|calls| SCHED0
SCHED0 -->|pushes TimerEvent| M_PQ[("Simulator::m_personalEvents<br/>priority_queue — min heap by timestamp and sequence")]

MAIN -->|calls| RUN["Simulator::run()"]


subgraph LOOP["Simulator::run() — Discrete Event Main Loop"]

CMP{"minimum next timestamp >= m_endTime?"}
PICK{"historical timestamp <= personal timestamp?"}

ADVH["set current time to historical timestamp; execute historical event; increment index"]
ADVP["set current time to personal timestamp; pop personal event; execute event"]
DISPATCH["Event::execute — virtual dispatch"]

end

RUN -->|reads next timestamp from| M_HIST
RUN -->|reads top timestamp from| M_PQ
RUN --> CMP

CMP -->|no| PICK
CMP -->|yes — break loop| LIQ["Portfolio::liquidate(m_orderBooks)"]

PICK -->|historical event wins ties| ADVH
PICK -->|personal event wins| ADVP

ADVH -->|modifies| M_TIME[("Simulator::m_currentTime")]
ADVP -->|modifies| M_TIME

ADVH --> DISPATCH
ADVP --> DISPATCH

DISPATCH -.->|loops back| CMP


LIQ -->|reads best bid, best ask and mark price| M_BOOKS
LIQ -->|creates closing Fill and calls| APPLYFILL["Portfolio::applyFill(fill)"]

LIQ --> CANCELALL["Simulator::cancelAllOpenOrders — final step inside run"]

CANCELALL -->|reads all order IDs from| M_O2S[("Simulator::m_OrderIdToSymbol")]
CANCELALL -->|calls for each order ID| OBCANCEL["OrderBook::processCancelOrder"]
CANCELALL -->|calls directly, bypassing event queue| HANDLE["Simulator::handleResponse"]

CANCELALL -->|run returns; main resumes| PRINTFILLS["print S.getFillsRecord()"]


subgraph EVENTS["Polymorphic Event::execute implementations"]

EADD["AddOrderEvent::execute"]
ECANCEL["CancelOrderEvent::execute"]
EMODIFY["ModifyOrderEvent::execute"]
ERETURN["MarketReturnEvent::execute"]
ETIMER["TimerEvent::execute"]

end

DISPATCH -.->|dynamic dispatch| EADD
DISPATCH -.->|dynamic dispatch| ECANCEL
DISPATCH -.->|dynamic dispatch| EMODIFY
DISPATCH -.->|dynamic dispatch| ERETURN
DISPATCH -.->|dynamic dispatch| ETIMER


EADD -->|"reads m_order.getSymbol and calls"| GETBOOK["Simulator::getOrderBook"]
GETBOOK -->|returns reference into| M_BOOKS

EADD -->|reads available cash| GETCASH["Portfolio::getAvailableCash"]
GETCASH -->|reads| M_CASH[("Portfolio::m_availableCash")]

EADD -->|calls| OBADD["OrderBook::processAddOrder"]
OBADD -->|returns vector of ResponseEvent| EADD

EADD -->|creates delayed response event| MKRET1["new MarketReturnEvent"]
MKRET1 -->|scheduled through Simulator| M_PQ


ECANCEL -->|"reads m_orderId and calls"| GETBOOKFOR["Simulator::getOrderBookForOrder"]
GETBOOKFOR -->|looks up symbol| M_O2S
GETBOOKFOR -->|returns reference from| M_BOOKS

ECANCEL -->|calls| OBCANCEL
OBCANCEL -->|returns ResponseEvent| ECANCEL

ECANCEL -->|creates and schedules MarketReturnEvent| M_PQ


EMODIFY -->|calls| GETBOOKFOR
EMODIFY -->|calls| OBMOD["OrderBook::processModifyOrder"]

OBMOD -->|returns vector of ResponseEvent| EMODIFY
EMODIFY -->|creates and schedules response events| M_PQ


ERETURN -->|calls| HANDLE

ETIMER -->|calls| RUNSTRAT["Simulator::runStrategy"]
ETIMER -->|calls| SCHEDT["Simulator::scheduleTimer"]

SCHEDT -->|pushes next TimerEvent| M_PQ


subgraph MATCH["OrderBook::processAddOrder — Matching Engine"]

WALK["walk price levels using price priority"]
WALKLIST["walk BookLevel orders using time priority"]
CASHCHK["if matching side is own, calculate affordable quantity"]
RECORD["OrderBook::recordTrade"]
UPDQTY["decrease quantity on both orders and level"]
ERASEFILL["fully filled existing order — erase order and list node"]
REST["leftover limit quantity — add to relevant price level"]
REBAL["OrderBook::rebalanceLevels"]

end

OBADD --> WALK

WALK -->|reads| M_ASKS[("m_relevantAsks / m_otherAsks<br/>map<Price, BookLevel>")]
WALK -->|reads| M_BIDS[("m_relevantBids / m_otherBids<br/>map<Price, BookLevel>")]

WALK --> WALKLIST

WALKLIST -->|traverses| ORDLIST["BookLevel.orders — List<Order>"]
WALKLIST --> CASHCHK

CASHCHK --> RECORD

RECORD -->|appends Filled or PartiallyFilled| RESPVEC["vector<ResponseEvent>"]
RECORD --> UPDQTY

UPDQTY -->|modifies| ORDLIST
UPDQTY -->|updates total quantity| M_ASKS
UPDQTY -->|updates total quantity| M_BIDS

UPDQTY -->|when existing quantity reaches zero| ERASEFILL

ERASEFILL -->|erases from| M_ACTIVE[("m_activeOrders<br/>unordered_map<OrderId, OrderLocation>")]
ERASEFILL -->|returns node to| M_POOL[("m_pool<br/>NodePool<Order>")]

OBADD -->|after matching loop| REST

REST -->|inserts into| M_ASKS
REST -->|inserts into| M_BIDS
REST -->|allocates node from| M_POOL
REST -->|records order location| M_ACTIVE
REST -->|appends Resting response| RESPVEC

OBADD --> REBAL

REBAL -->|moves price levels between relevant and other maps| M_ASKS
REBAL -->|moves price levels between relevant and other maps| M_BIDS

OBADD -->|returns| RESPVEC


OBCANCEL -->|looks up order| M_ACTIVE
OBCANCEL -->|erases list node and returns node| M_POOL

OBCANCEL -->|if level becomes empty, erases level| M_ASKS
OBCANCEL -->|if level becomes empty, erases level| M_BIDS

OBCANCEL -->|if level was emptied, rebalances| REBAL
OBCANCEL -->|erases order entry| M_ACTIVE


OBMOD -->|looks up order| M_ACTIVE
OBMOD -->|internally calls; response discarded| OBCANCEL
OBMOD -->|builds modified order and calls| OBADD


subgraph RESPFLOW["Response / Fill Propagation into Simulator State"]

CHKOWN{"response is own order?"}
IGNORE["ignore — Simulator only tracks own order state"]

UPDO2S["update m_OrderIdToSymbol based on response type"]
MKFILL["construct Fill"]
PUSHFILL["append Fill to fills record"]
PUSHPEND["append response to pending responses"]

end

HANDLE --> CHKOWN

CHKOWN -->|no| IGNORE
CHKOWN -->|yes| UPDO2S

UPDO2S -->|modifies| M_O2S

UPDO2S -->|Filled or PartiallyFilled| MKFILL

MKFILL --> APPLYFILL

APPLYFILL -->|updates cash and realized PnL| M_CASH
APPLYFILL -->|modifies| M_POS[("Portfolio::m_positions<br/>unordered_map<Symbol, PositionState>")]

MKFILL --> PUSHFILL
PUSHFILL -->|appends| M_FILLS[("Simulator::m_fillsRecord")]

UPDO2S --> PUSHPEND
PUSHPEND -->|appends| M_PEND[("Simulator::m_pendingResponses")]


subgraph STRAT["Strategy Callback Loop — Latency Modeled"]

CHKT{"current time >= strategy next available time?"}
DRAIN["move and clear pending responses into local responses"]
ONTIME["Strategy::onTime — virtual"]
TIMEIT["measure strategy processing time"]
SETNEXT["update m_strategyNextAvailableTime"]
ADDLAT["add send latency to each returned action"]
SCHEDACT["Simulator::scheduleEvent"]

end

RUNSTRAT --> CHKT

CHKT -->|no — too soon, skip| RUNSTRAT
CHKT -->|yes| DRAIN

DRAIN -->|reads and clears| M_PEND
DRAIN --> TIMEIT

TIMEIT --> ONTIME

ONTIME -->|reads| M_BOOKS
ONTIME -->|reads| M_PORT[("Simulator::m_portfolio")]

ONTIME -.->|dynamic dispatch| ASTRAT["AStrategy::onTime — stub"]

ONTIME -->|returns optional vector of Events| TIMEIT

TIMEIT --> SETNEXT

SETNEXT -->|modifies| M_SNEXT[("Simulator::m_strategyNextAvailableTime")]

SETNEXT --> ADDLAT
ADDLAT --> SCHEDACT

SCHEDACT -->|modifies| M_PQ


subgraph OUTPUT["Post-run Reporting"]

PRINTPOS["print Portfolio position, cash, equity and PnL"]
PRINTBOOKS["print OrderBook per symbol — relevant top levels"]

end

PRINTFILLS --> PRINTPOS

